# ============================================================
# منصة وعي الشباب BBA - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================
# Required: Duplicate this file as .env and set your values.
#         : Or set these as server environment variables.
# ============================================================

# --- Supabase Configuration ---
# Get these from your Supabase project dashboard:
#   Settings → API → Project URL
#   Settings → API → anon / public key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- Service Worker ---
# Set to the base path where the app is hosted.
# Examples: "" (root), "/code-server", "/app"
APP_BASE_PATH=

# --- PWA ---
# The display name for the PWA (shown on the home screen)
PWA_NAME=منصة وعي الشباب BBA
PWA_SHORT_NAME=وعي BBA

# --- Contact Information ---
# These are shown on the contact section
CONTACT_EMAIL=abdelilah.sidiali@univ-bba.dz
CONTACT_PHONE=+213540735461
CONTACT_PHONE_ALT=+213665376480
CONTACT_WHATSAPP=+213540735461

# --- Deployment ---
# The public URL where the app is deployed (no trailing slash)
PUBLIC_URL=https://your-domain.com

# --- Feature Flags ---
# Enable or disable features
ENABLE_SERVICE_WORKER=true
ENABLE_SUPABASE_SYNC=true
ENABLE_ANALYTICS=false
ENABLE_OFFLINE_MODE=true
